{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyD-Org/platform/contracts/cuotas/v1/schema.json",
  "title": "ContratoCuotasV1",
  "description": "Respuesta 200 de GET {CRM}/api/internal/shop/cuotas?tenant=… — medios de pago y opciones de cuotas que el tenant decide ofrecer. Sólo viajan filas activas; la vigencia la evalúa el consumidor (Shop) con su reloj, por fecha en hora Argentina, inclusive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenant", "actualizadoEn", "medios", "opciones"],
  "properties": {
    "version": { "const": "v1" },
    "tenant": { "type": "string", "minLength": 1 },
    "actualizadoEn": {
      "description": "ISO 8601 (UTC). Última modificación de medios u opciones del tenant; si no hay filas, el momento de la respuesta.",
      "type": "string",
      "format": "date-time"
    },
    "medios": { "type": "array", "items": { "$ref": "#/$defs/MedioDePago" } },
    "opciones": { "type": "array", "items": { "$ref": "#/$defs/OpcionConfigurada" } }
  },
  "$defs": {
    "Fecha": {
      "description": "Fecha calendario YYYY-MM-DD (hora Argentina), inclusive.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "MedioDePago": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proveedor", "codigo", "nombre", "activo", "orden"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "proveedor": { "description": "Ej. \"mercadopago\".", "type": "string", "minLength": 1 },
        "codigo": { "description": "Código del medio en el proveedor. Ej. \"visa\", \"master\".", "type": "string", "minLength": 1 },
        "nombre": { "type": "string", "minLength": 1 },
        "activo": { "type": "boolean" },
        "orden": { "type": "integer" }
      }
    },
    "OpcionConfigurada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "medioId", "cuotas", "sinInteres", "montoMinimo", "vigenteDesde", "vigenteHasta", "activo"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "medioId": { "description": "id de un elemento de `medios`.", "type": "string", "minLength": 1 },
        "cuotas": { "type": "integer", "minimum": 2, "maximum": 24 },
        "sinInteres": {
          "description": "Lo que el tenant QUIERE ofrecer. Es sin interés efectivo sólo si además la tasa del proveedor para esas cuotas es 0.",
          "type": "boolean"
        },
        "montoMinimo": { "description": "Con IVA, en ARS. 0 = sin mínimo.", "type": "number", "minimum": 0 },
        "vigenteDesde": { "oneOf": [{ "$ref": "#/$defs/Fecha" }, { "type": "null" }] },
        "vigenteHasta": { "oneOf": [{ "$ref": "#/$defs/Fecha" }, { "type": "null" }] },
        "activo": { "type": "boolean" }
      }
    }
  }
}
